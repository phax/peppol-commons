<wsdl:definitions xmlns:tns="ec:services:wsdl:BDMSL:monitoring:1.0" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:lrs="ec:services:wsdl:BDMSL:monitoring:data:1.0"
                  xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:http="http://schemas.xmlsoap.org/wsdl/http/"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" name="BDMSLMonitoringService"
                  targetNamespace="ec:services:wsdl:BDMSL:monitoring:1.0"
                  xmlns:bd="http://busdox.org/serviceMetadata/locator/1.0/">
    <wsdl:types>
        <s:schema>
            <s:import namespace="ec:services:wsdl:BDMSL:monitoring:data:1.0" schemaLocation="BDMSLMonitoringService-1.0.xsd"/>
            <s:import namespace="http://busdox.org/serviceMetadata/locator/1.0/" schemaLocation="peppol-sml-types-v1.xsd"/>
        </s:schema>
    </wsdl:types>

    <wsdl:message name="isAliveIn">
        <wsdl:part name="messagePart" element="lrs:IsAlive" />
    </wsdl:message>

    <wsdl:message name="isAliveOut"/>

    <wsdl:message name="internalErrorFault">
        <wsdl:part name="fault" element="bd:InternalErrorFault"/>
    </wsdl:message>

    <wsdl:portType name="BDMSLMonitoringServiceSoap">
        <wsdl:operation name="IsAlive">
            <wsdl:input message="tns:isAliveIn"/>
            <wsdl:output message="tns:isAliveOut"/>
            <wsdl:fault message="tns:internalErrorFault" name="InternalErrorFault"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="BDMSLMonitoringServiceSoap" type="tns:BDMSLMonitoringServiceSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>

        <wsdl:operation name="IsAlive">
            <soap:operation soapAction="ec:services:wsdl:BDMSL:monitoring:1.0:isAliveIn" style="document"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="BDMSLMonitoringService">
        <wsdl:port name="BDMSLMonitoringServicePort" binding="tns:BDMSLMonitoringServiceSoap">
            <soap:address location="unknown"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>