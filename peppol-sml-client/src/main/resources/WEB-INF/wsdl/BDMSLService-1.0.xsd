<xs:schema xmlns="ec:services:wsdl:BDMSL:data:1.0"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:bd="http://busdox.org/serviceMetadata/locator/1.0/"
           xmlns:id="http://busdox.org/transport/identifiers/1.0/"
           targetNamespace="ec:services:wsdl:BDMSL:data:1.0"
           elementFormDefault="qualified"
           id="BDMSLTypes">
    <xs:import namespace="http://busdox.org/serviceMetadata/locator/1.0/" schemaLocation="peppol-sml-types-v1.xsd"/>
    <xs:import namespace="http://busdox.org/transport/identifiers/1.0/" schemaLocation="peppol-identifiers-v1.xsd"/>
    <xs:element name="PrepareChangeCertificate" type="PrepareChangeCertificateType"/>
    <xs:element name="SMPAdvancedServiceForParticipantService" type="SMPAdvancedServiceForParticipantType"/>
    <xs:element name="IsAlive" type="IsAliveType"/>
    <xs:element name="ExistsParticipant" type="ParticipantsType"/>
    <xs:element name="ExistsParticipantResponse" type="ExistsParticipantResponseType"/>
    <xs:element name="SMPRefreshActiveStatus" type="SMPRefreshActiveStatus"/>
    <xs:element name="SMPRefreshActiveStatusResponse" type="SMPRefreshActiveStatusResponseType"/>
    <xs:element name="ManageChangeCertificateRequest" type="ManageChangeCertificateType"/>
    <xs:element name="ManageChangeCertificateResponse" type="ManageChangeCertificateResponseType"/>
    <xs:complexType name="PrepareChangeCertificateType">
        <xs:sequence>
            <xs:element name="newCertificatePublicKey" type="xs:string">
                <xs:annotation>
                    <xs:documentation>The new public key contained in the certificate.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="migrationDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>The migration date for the new certificate. Can't be in the past.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ManageChangeCertificateType">
        <xs:sequence>
            <xs:element name="Action" type="xs:token">
                <xs:annotation>
                    <xs:documentation>
                            The action to perform for the certificate change. Possible values are: UPSERT, READ, DELETE. The action is case insensitive.
                        The expected behavior for each action is as follows:
                        - UPSERT: If the certificate already exists, it will be updated with the new certificate/date. If it doesn't exist, it will be created.
                        - READ: The current certificate will be retrieved and returned in the response. The certificate element
                        will be ignored in the request.
                        - DELETE: The current certificate will be deleted. The certificate element will be ignored in the request.
                        - ACTIVATE: The provided certificate in requests will be activated immediately. If certificate is not provided, the current prepared certificate will be activated immediately.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Certificate" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>The new X509Certificate as base64 or PEM encoded.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="MigrationDate" type="xs:dateTime" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>The migration date for the new certificate. Can't be in the past. In case the
                        migration date is not provided, the certificate valid from date will be used as migration date.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ManageChangeCertificateResponseType">
        <xs:complexContent>
            <xs:extension base="ManageChangeCertificateType">
                <xs:sequence>
                    <xs:element name="Status" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>Status description</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="SMPAdvancedServiceForParticipantType">
        <xs:sequence>
            <xs:element name="CreateParticipantIdentifier" type="bd:ServiceMetadataPublisherServiceForParticipantType"/>
            <xs:element name="serviceName" type="xs:string">
                <xs:annotation>
                    <xs:documentation>The name of the service for the NAPTR record.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ListParticipantsType">
        <xs:sequence>
            <xs:element name="participant" type="ParticipantsType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ParticipantsType">
        <xs:sequence>
            <xs:element ref="id:ParticipantIdentifier">
                <xs:annotation>
                    <xs:documentation>The participant identifier</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="bd:ServiceMetadataPublisherID">
                <xs:annotation>
                    <xs:documentation>The SMP identifier</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="IsAliveType"/>
    <xs:complexType name="ExistsParticipantResponseType">
        <xs:sequence>
            <xs:element ref="id:ParticipantIdentifier">
                <xs:annotation>
                    <xs:documentation>The participant identifier</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element ref="bd:ServiceMetadataPublisherID">
                <xs:annotation>
                    <xs:documentation>The SMP identifier</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Exist" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>True if the participant is already registered on the SMP.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="SMPRefreshActiveStatus">
        <xs:sequence>
            <xs:element ref="bd:ServiceMetadataPublisherID">
                <xs:annotation>
                    <xs:documentation>The SMP identifier</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="SMPRefreshActiveStatusResponseType">
        <xs:sequence>
            <xs:element name="ActiveUntil" type="xs:dateTime">
                <xs:annotation>
                    <xs:documentation>The future date time in UTC coordinates until when the SMP is considered active.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
